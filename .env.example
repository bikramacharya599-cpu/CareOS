# CareOS demo configuration
VITE_CAREOS_MODE=demo
# Frontend API URL. The frontend remains demo-only in this phase.
VITE_CAREOS_API_URL=http://localhost:3001

# CareOS API
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# PostgreSQL development database only. Never commit real credentials.
DATABASE_URL=postgresql://careos_dev:change-me@localhost:5432/careos_dev
DATABASE_SSL=false
